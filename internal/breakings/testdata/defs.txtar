Test file for defs.
"want" contains the desired result. We only care that we got every type and method;
assume that they're associated with the right decl or spec.
-- want --
types: A C b
methods: A.M A.N b.M b.N
-- a.go --
package p

type A int

type (
	b int
	C int
)

const E = 1

var D = 2

func (A) M() {}
func (*A) N() {}
func (A) u() {}

func (b) M() {}
func (*b) N() {}
func (*b) u() {}
